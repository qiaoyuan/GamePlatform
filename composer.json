{
    "name": "aaron/base",
    "description": "base",
    "type": "project",
    "keywords": [
        "framework",
        "thinkphp",
        "ORM"
    ],
    "homepage": "https://www.aaron.com",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "aaron",
            "email": "281313840@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0.0",
        "topthink/think-orm": "^3.0",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-bcmath": "*",
        "ext-redis": "*",
        "guzzlehttp/guzzle": "^7.3",
        "topthink/think-multi-app": "^1.0",
        "lcobucci/jwt": "^5.3",
        "topthink/think-helper": "^3.1",
        "topthink/think-filesystem": "^2.0",
        "phpoffice/phpspreadsheet": "^1.27",
        "topthink/think-image": "^1.0",
        "cache/simple-cache-bridge": "^1.2",
        "cache/redis-adapter": "^1.2",
        "topthink/think-queue": "^3.0",
        "lcobucci/clock": "^3.2",
        "yansongda/pay": "^3.7"
    },
    "require-dev": {
        "symfony/var-dumper": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "test\\": "test"
        },
        "psr-0": {
            "": "extend/"
        },
        "files": [
            "app/helper.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "easywechat-composer/easywechat-composer": false
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
