
.category{
	width: 100%;
	height: 100%;
	display: flex;
.left{
		width: 200rpx;
		height: 100%;
		border-right: 1px solid #eee;
view {
			height: 60px;
			line-height: 60px;
			color: #333;
			text-align: center;
			font-size: 30rpx;
			border-top: 1px solid #eee;
}
.active {
			/* background: $shop-color; */
			color: deepskyblue;
}
}
.right{
		height: 100%;
		width: 520rpx;
		margin: 10rpx auto;
.item{
			position: relative;
			margin-top: 30rpx;
			border-bottom: 1px solid #C0C0C0;
			height: 140rpx;
.main{
				font-size: 0.75rem;
				font-weight: 600;
}
.text{
				font-size: 16rpx;
				color: gray;
				margin: 12rpx 0;
}
.price{
				color: #f4ea2a;
				position: absolute;
				bottom: 20rpx;
				left: 0rpx;
}
.total{
				font-size: 16rpx;
				position: absolute;
				bottom: 20rpx;
				right: 180rpx;
				color: gray;
}
.img{
				width: 2rem;
				height: 4rem;
				position: absolute;
				right: 100rpx;
				bottom: 20rpx;
}
}
.none {
			color: #eeeeee;
}
}
}

