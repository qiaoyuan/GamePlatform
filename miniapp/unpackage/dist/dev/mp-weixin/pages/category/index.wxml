<view class="category"><scroll-view class="left" scroll-y="{{true}}"><block wx:for="{{cates}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view data-event-opts="{{[['tap',[['leftClickHandle',[index,'$0'],[[['cates','id',item.id,'id']]]]]]]}}" class="{{[actives===index?'active':'']}}" bindtap="__e">{{''+item.classifyName+''}}</view></block></scroll-view><scroll-view class="right" scroll-y="{{true}}"><block wx:for="{{secondData}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['clickTest',['$0'],[[['secondData','id',item.id]]]]]]]}}" class="item" bindtap="__e"><view class="main">{{''+item.title+''}}</view><view class="text">{{''+item.text+''}}</view><view class="price">{{'￥'+item.price+''}}</view><view class="total">{{''+item.total+'人已测'}}</view><view class="img"><image src="{{$root.m0}}" alt class="_img"></image></view></view></block><block wx:if="{{$root.g0===0}}"><text class="none">暂无数据,请浏览其他页面!</text></block></scroll-view></view>