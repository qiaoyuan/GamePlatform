<block wx:if="{{!!topicInfoObj}}"><view class="topic-info-container data-v-69c7f0c0"><view class="topic-container data-v-69c7f0c0"><text style="font-weight:800;font-size:20px;" class="data-v-69c7f0c0">{{''+topicInfoObj._tid+"、"+topicInfoObj.title+''}}</text></view><view class="options-container data-v-69c7f0c0"><block wx:for="{{topicInfoObj.options}}" wx:for-item="optionItem" wx:for-index="optionIndex" wx:key="optionIndex"><button class="options-item data-v-69c7f0c0" style="{{'border:'+(optionItem.style?'1px solid #f8df2d':'')+';'}}" data-oid="{{optionIndex}}" data-event-opts="{{[['tap',[['onClickOption',['$event']]]]]}}" bindtap="__e"><view class="options-icon _i data-v-69c7f0c0">{{optionsMarkList[optionIndex]}}</view><text class="options-content data-v-69c7f0c0">{{optionItem.title}}</text><text style="{{'width:30rpx;height:30rpx;border:2px solid #f8df2d;border-radius:50%;position:absolute;right:30rpx;top:20rpx;'+('background:'+(optionItem.style?'#f8df2d':'')+';')}}" class="data-v-69c7f0c0"></text></button></block></view><block wx:if="{{topicInfoObj.questionCategory===1&&!topicInfoObj.confirm}}"><button class="confirm-btn data-v-69c7f0c0" type="primary" data-event-opts="{{[['tap',[['onClickConfirm',['$event']]]]]}}" bindtap="__e">确认</button></block></view></block>